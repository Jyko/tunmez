{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "env": {
    "PLAYWRIGHT_MCP_BROWSER": "chromium",
    "PLAYWRIGHT_MCP_HEADLESS": "true",
    "PLAYWRIGHT_MCP_ISOLATED": "true",
    "PLAYWRIGHT_MCP_VIEWPORT_SIZE": "1280x800"
  },
  "enabledPlugins": {
    "gopls-lsp@anthropic-plugin-directory": true
  },
  "permissions": {
    "allow": [
      "Bash(go build *)",
      "Bash(go test *)",
      "Bash(go vet *)",
      "Bash(go list *)",
      "Bash(go mod tidy)",
      "Bash(golangci-lint run *)",
      "Bash(golangci-lint fmt *)",
      "Bash(wails3 build)",
      "Bash(wails3 doctor)",
      "Bash(wails3 generate bindings *)",
      "Bash(npm run test)",
      "Bash(npm run lint)",
      "Bash(npm run type-check)",
      "Bash(npm run build)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(.claude/skills/browser-preview/scripts/start.sh *)",
      "Bash(.claude/skills/browser-preview/scripts/stop.sh)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  }
}
