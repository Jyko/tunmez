<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="tunmez"
        Arguments=""
        InstallLocation="C:\Program Files\tunmez\tunmez">
    </Installer>
    <PackageInformation
        PackageName="tunmez"
        PackageDisplayName="tunmez"
        PublisherName="CN=tunmez"
        PublisherDisplayName="tunmez"
        Version="0.1.0.0"
        PackageDescription="Crop rotation planner for market-gardening farms">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="io.github.jyko.tunmez"
                Description="Crop rotation planner for market-gardening farms"
                DisplayName="tunmez"
                ExecutableName="tunmez"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>tunmez</DisplayName>
            <PublisherDisplayName>tunmez</PublisherDisplayName>
            <Description>Crop rotation planner for market-gardening farms</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="tunmez.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
